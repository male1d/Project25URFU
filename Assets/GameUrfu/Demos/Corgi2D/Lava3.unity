  DialogueBoxPrefab: {fileID: 199184, guid: 927a7e5e78367cc4ba304dae75c80ddf, type: 3}
  TextBackgroundColor: {r: 1, g: 0.50020283, b: 0.17647058, a: 1}
  TextColor: {r: 1, g: 1, b: 1, a: 1}
  ArrowVisible: 1
  TextFont: {fileID: 0}
  TextSize: 20
  Alignment: 4
  FadeDuration: 0.2
  TransitionTime: 0.2
  DistanceFromTop: 1
  BoxesFollowZone: 0
  CanMoveWhileTalking: 0
  ButtonHandled: 1
  MessageDuration: 3
  ActivableMoreThanOnce: 1
  InactiveTime: 2
  Dialogue:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C
    \u0433\u043E\u0440\u044F\u0447\u0435\u0435 \n\u043C\u0435\u0441\u0442\u043E!
    \u0417\u0434\u0435\u0441\u044C \u043C\u044B \u043C\u0430\u0439\u043D\u0438\u043B\u0438
    \n\u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u0443."
  - "\u041E\u043D\u0438 \u0441\u043B\u043E\u043C\u0430\u043B\u0438 \u0432\u0441\u0435
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u044B.\n\u041F\u043E\u043C\u043E\u0433\u0438
    \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E!"
  - "\u0412 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
    \u043D\u0430 \u043D\u0430\u0448 \u043C\u0438\u0440\n\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0430\u0442\u0430\u043A\u0438!"
  - "\u0418 \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
    \n\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u043E\u0439"
  - "\u041E\u0434\u043E\u043B\u0435\u0439 \u0438\u0445 \u0432\u0441\u0435\u0445 ,
    \u0438 \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F\n\u043D\u0430
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
  - "\u0422\u0430\u043C \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435
    \u0431\u043E\u043B\u044C\u0448\u0435 \n\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438."

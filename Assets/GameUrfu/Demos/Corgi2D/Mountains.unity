      m_Calls: []
  DialogueBoxPrefab: {fileID: 199184, guid: 927a7e5e78367cc4ba304dae75c80ddf, type: 3}
  TextBackgroundColor: {r: 0, g: 0, b: 0, a: 1}
  TextColor: {r: 1, g: 1, b: 1, a: 1}
  ArrowVisible: 1
  TextFont: {fileID: 0}
  TextSize: 20
  Alignment: 4
  FadeDuration: 0.2
  TransitionTime: 0.2
  DistanceFromTop: 0.6
  BoxesFollowZone: 0
  CanMoveWhileTalking: 0
  ButtonHandled: 1
  MessageDuration: 3
  ActivableMoreThanOnce: 0
  InactiveTime: 2
  Dialogue:
  - "\u041F\u0440\u0438\u0432\u0435\u0442 , \u043F\u043E\u0440\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435\n\u043D\u043E\u0432\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E!"
  - "\u0414\u0443\u043C\u0430\u044E \u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B
    , \u0447\u0442\u043E \u043C\u044B \n\u043C\u043D\u043E\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043C
    \u043E \u0431\u0438\u0442\u043A\u043E\u0438\u043D\u0435"
  - "\u0422\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u0448\u044C \u043F\u043E\u0447\u0435\u043C\u0443?
    \u0410 \u044F\n\u043E\u0442\u0432\u0435\u0447\u0443 - \u043E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u0430\u043C\u043E\u0439\n\u043F\u0435\u0440\u0432\u043E\u0439 \u0432 \u043C\u0438\u0440\u0435
    \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u043E\u0439!"
  - "\u0422\u0430\u043A \u0436\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438 ,
    \u0447\u0442\u043E\n\u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u0432\u0441\u0435
    \u0441\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0430\n\u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u0443
    , \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C\n\u0438\u0445
    \u0431\u0435\u0437\u0432\u043E\u0437\u0440\u0430\u0442\u043D\u043E!"
  - "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0441\u0435\u0433\u0434\u0430
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u0441\u0435\u0431\u0435\n\u043A\u0430\u043A\u0443\u044E-\u0442\u043E
    \u0447\u0430\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u0434\u0441\u0442\u0432."
  - "\u0422\u0430\u043A \u0436\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043C\u043D\u043E\u0433\u043E\n\u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432
    , \u0433\u0434\u0435 \u0442\u043E\u0432\u0430\u0440 \u043C\u043E\u0436\u043D\u043E\n\u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
    \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u043E\u0439"
